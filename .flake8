# wemake-python-styleguide gate for new Python code (see implement skill).
# Six rules are off repo-wide, all Django-declarative collisions:
#   WPS110  managers are named `objects` by framework convention
#   WPS226  model/field kwargs repeat names declaratively
#   WPS431  nested TextChoices (Status/Role/Scope) are Django+repo convention
#   WPS432  max_length= / choices= literals in field declarations
#   WPS347  Q/F expression imports are the required pattern
#   WPS458  `django.db.models` + `django.db` imports collide by necessity
# Per-file: scheduling/availability.py ignores WPS210/WPS221/WPS231 — the
# slot pipeline stages (rules, candidates, filter, dedupe) are the natural
# units; further extraction breaches the 7-member cap or contorts the loop.
# Per-file: scheduling/serializers.py ignores WPS615 — DRF calls the
# SerializerMethodField hook get_<field_name> by framework convention.
# Per-file: config/__init__.py ignores WPS300/WPS410/WPS412 — content is the
# Celery-prescribed bootstrap, which cannot live anywhere else.
# Per-file: access/views.py ignores WPS201 — check + recent-events views
# share one module rather than one-import-per-view files.
# Per-file: tests ignore WPS501 — thread race tests release the DB
# connection in a bare try/finally; there is no exception to catch.
# Per-file: seed_e2e.py ignores WPS201/WPS202 — the E2E dataset touches every model
# once by design, one builder per concern; splitting it would scatter one
# dataset across modules.
# Per-file: seed_demo.py ignores WPS201/WPS202/WPS210/WPS211/WPS221 — the
# demo world needs one builder per concern (cast, schedule, passes,
# bookings) plus the domain imports each consumes; fewer members would
# merge unrelated builders, more helpers would exist only to shorten.
# Per-file: seed_helpers.py ignores WPS201/WPS202/WPS210/WPS211/WPS221 — one shared
# builder per seed concern with the domain imports each consumes; fewer
# members or bundled options would merge unrelated builders or obscure
# the call sites.
# Per-file: access/services.py ignores WPS202 — the door decision needs one
# predicate per grant path (pass, booking, staff) plus shared helpers;
# splitting it would scatter a single verdict.
# Per-file: test_browser.py ignores WPS202/WPS210/WPS213 — linear E2E scripts;
# splitting further would be helpers that exist only to shorten.
# Per-file: booking/views.py, aggregators/views.py ignore WPS201;
# scheduling/views.py ignores WPS201 + WPS202 (old + new catalogue viewsets
# coexist during the expand transition; contract deletes the old half) —
# endpoint files grow one view per staff ticket by design; splitting by
# ticket would scatter the API surface across modules.
# Per-file: booking/cancellations.py ignores WPS202/WPS211 — the cancel
# flow is one transaction split into named steps (load, check, decide,
# write); the public seam keeps ticket-mandated keyword args explicit.
# Per-file: booking/services.py ignores WPS202/WPS211 — one transaction
# split into named steps (lock, validate, select, create); splitting the
# module would scatter a single flow, and channel kwargs stay explicit.
# Per-file: organizations/models.py ignores legacy E501/WPS237/WPS601 (long help
# strings + attribute shadowing predate the gates; this ticket's diff is the
# time_zone validator only).
# Per-file: settings/base.py ignores WPS407 (module constants by Django
# convention) and E501 (dotted validator paths stay whole for grep).
[flake8]
max-line-length = 88
max-asserts = 6
# max-asserts 6 (default 5): cancel/booking tests assert one full outcome
# (status + record fields + ledger + strike count) per test; splitting
# further would scatter a single behavior across tests.
extend-ignore =
    WPS110,
    WPS226,
    WPS431,
    WPS432,
    WPS347,
    WPS458
exclude =
    .venv,
    .git,
    __pycache__,
    graft,
    assets,
    */migrations/*

per-file-ignores =
    tests/e2e/test_browser.py:
        WPS202,
        WPS210,
        WPS213,
    booking/views.py:
        WPS201,
    organizations/views.py:
        WPS202,
    aggregators/views.py:
        WPS201,
    scheduling/views.py:
        WPS201,
        WPS202,
    booking/cancellations.py:
        WPS202,
        WPS211,
    booking/services.py:
        WPS202,
        WPS211,
    organizations/models.py:
        E501,
        WPS237,
        WPS601,
    config/settings/base.py:
        E501,
        WPS407,
    organizations/management/commands/seed_e2e.py:
        WPS201,
        WPS202,
    organizations/management/commands/seed_demo.py:
        WPS201,
        WPS202,
        WPS210,
        WPS211,
        WPS221,
    organizations/management/seed_helpers.py:
        WPS201,
        WPS202,
        WPS210,
        WPS211,
        WPS221,
    access/services.py:
        WPS202,
    config/__init__.py:
        WPS300,
        WPS410,
        WPS412,
    access/views.py:
        WPS201,
    scheduling/availability.py:
        WPS210,
        WPS221,
        WPS231,
    scheduling/serializers.py:
        WPS615,
    tests/*:
        E501,
        WPS111,
        WPS114,
        WPS117,
        WPS118,
        WPS122,
        WPS201,
        WPS202,
        WPS204,
        WPS210,
        WPS211,
        WPS214,
        WPS221,
        WPS229,
        WPS338,
        WPS430,
        WPS501,
