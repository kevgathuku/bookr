		"@fullcalendar/timegrid": "^6.1.22",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.105.0",
		"moment-timezone": "^0.6.5",
		"openapi-fetch": "^0.17.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
